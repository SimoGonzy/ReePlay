{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReePlay",
  "mainBinaryName": "reeplay",
  "version": "0.4.3",
  "identifier": "dev.musicapp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "ReePlay", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 580 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "license": "MIT",
    "licenseFile": "../../LICENSE",
    "copyright": "Copyright (c) 2026 Simone Gonzato",
    "targets": ["nsis"],
    "externalBin": ["binaries/musicapp-backend"],
    "resources": ["bundled-tools/**/*", "python-licenses/**/*", "../../LICENSE"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
